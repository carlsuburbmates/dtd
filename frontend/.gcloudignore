# Keep source deployment bounded and reproducible. Dependencies are restored in
# the Docker build; generated bundles and local test artefacts are not inputs.
.gcloudignore
.git
.gitignore
node_modules/
build/
coverage/
test-results/
playwright-report/
.env
.env.*
!.env.example
npm-debug.log*
yarn-debug.log*
yarn-error.log*
