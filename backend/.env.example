MONGO_URL=mongodb://localhost:27017
DB_NAME=dtd
CORS_ORIGINS=*
ADMIN_PASS=change-me
ACTIVE_REGION=Greater Melbourne
ACTIVE_REGIONS=Greater Melbourne
AUTONOMY_LOOP_OWNER=api
RUN_AUTONOMY_IN_API=1
AUTONOMY_LOOP_LEASE_ENABLED=1
AUTONOMY_LOOP_LEASE_TTL_S=120
AUTONOMY_LOOP_LEASE_RENEW_S=30
AUTONOMY_OWNER_ID=
DISABLE_AUTONOMY=0
ENABLE_STARTUP_SEEDS=0
PUBLIC_LAUNCH_PHASE=live_matching
CLAIM_STATE_MODEL_ENABLED=0
CLAIM_STATE_CURRENT=STATE_4
CLAIM_ENFORCEMENT_MODE=disabled
CLAIM_BLOCK_MELBOURNE_WIDE_BELOW_STATE_2=0
TRAINER_ACTION_TOKEN_SECRET=change-me
TRAINER_ACTION_TOKEN_TTL_S=1209600
TRAINER_CLAIM_OTP_SECRET=change-me
TRAINER_CLAIM_OTP_TTL_S=900
TRAINER_CLAIM_OTP_MAX_ATTEMPTS=5
TRAINER_CLAIM_SESSION_TTL_S=86400
ABR_GUID=
GOOGLE_PLACES_API_KEY=
FOLLOW_UP_TOKEN_SECRET=change-me
FOLLOW_UP_LINK_TTL_S=1209600
FOLLOW_UP_LEGACY_INTRO_ID_SUPPORT_UNTIL=
OVERSIGHT_AUTH_MAX_ATTEMPTS=10
OVERSIGHT_AUTH_WINDOW_S=600
OVERSIGHT_AUTH_LOCK_S=900
FRONTEND_BASE_URL=http://127.0.0.1:3001
# Cloud Scheduler authenticates the Pro-trial warning job with a Google-signed
# OIDC token. Set both values in Cloud Run; the audience is the Cloud Run
# service URL, not the custom domain or individual job path.
CLOUD_SCHEDULER_OIDC_SERVICE_ACCOUNT=
CLOUD_SCHEDULER_OIDC_AUDIENCE=
DISCOVERY_SOURCE_URLS=
SOURCE_INGEST_FAILURE_SUPPRESS_AFTER=3
SOURCE_INGEST_ALERT_AFTER=2
SOURCE_INGEST_SUPPRESS_HOURS=24
RESEND_API_KEY=
RESEND_FROM=no-reply@dogtrainersdirectory.com.au
RESEND_REPLY_TO=info@dogtrainersdirectory.com.au
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_DEFAULT_CURRENCY=aud
# A Stripe key can be configured for webhook verification or pre-launch work
# without accepting purchases. Set to 1 only for the final approved billing launch.
ENABLE_TRAINER_BILLING_CHECKOUT=0
# Pro trial cohort is anchored to Stripe live mode. Set STRIPE_LIVE_ANCHOR_AT
# (ISO timestamp) at the moment Stripe goes live; only trainers claimed or
# registered at/after that anchor are eligible. Stripe starts the 30-day period
# when an eligible trainer creates a Pro subscription. Warning fires on day 23.
PRO_TRIAL_DAYS=30
PRO_TRIAL_EXPIRY_WARNING_DAY=23
STRIPE_LIVE_ANCHOR_AT=
SPONSOR_RESERVATION_TTL_MINUTES=30
SPONSOR_MAX_SUBURBS_PER_TRAINER=4
ENABLE_OPS_STRIPE_REFUNDS=0
BILLABILITY_POLICY=allow
CONTACT_READY_POLICY=allow
NOTIFY_RETRY_ATTEMPTS=3
REACTIVATION_NOTIFY_COOLDOWN_HOURS=168
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT_S=5.0

# SEO pages are fail-closed: new pages are only generated/persisted when both
# explicit production thresholds are met. These are adjustable after real
# publishing and traffic evidence exists.
SEO_MIN_PUBLISHED_TRAINERS=3
SEO_MIN_CONTENT_WORDS=500

# Observability
SENTRY_DSN=
SENTRY_ORG=dtd-i9
SENTRY_PROJECT=dtd
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
